{
  "name": "@chkp/cloud-firewall-mcp",
  "version": "0.1.0",
  "description": "MCP server for Check Point Cloud Firewall management",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cloud-firewall-mcp": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CheckPointSW/mcp-servers.git",
    "directory": "packages/cloud-firewall"
  },
  "keywords": [
    "checkpoint",
    "mcp",
    "model-context-protocol",
    "cloud-firewall",
    "cfwaas"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "npm run clean && npm run build:tsc && npm run build:bundle",
    "build:bundle": "node ../../bundle-mcp.js",
    "build:tsc": "npx tsc && npx shx chmod +x ./dist/index.js && npx shx cp src/server-config.json dist/",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint --no-error-on-unmatched-pattern 'src/**/*.ts' '__tests__/**/*.ts'",
    "pretest": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepack": "node ../../scripts/strip-bundled-deps.js",
    "postpack": "node ../../scripts/strip-bundled-deps.js restore"
  },
  "dependencies": {
    "@chkp/mcp-utils": "*",
    "@chkp/quantum-infra": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.16.0",
    "commander": "^14.0.3",
    "node-machine-id": "^1.1.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.0.4"
  }
}

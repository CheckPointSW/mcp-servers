{
  "name": "@chkp/reputation-service-mcp",
  "version": "1.3.1",
  "bin": {
    "reputation-service-mcp": "dist/index.js"
  },
  "description": "Reputation Service MCP server of Check Point",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run build:bundle && npx shx chmod +x ./dist/index.js && npx shx cp src/server-config.json dist/",
    "build:bundle": "node ../../bundle-mcp.js",
    "build:tsc": "npx tsc && npx shx chmod +x ./dist/index.js && npx shx cp src/server-config.json dist/",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepack": "node ../../scripts/strip-bundled-deps.js",
    "postpack": "node ../../scripts/strip-bundled-deps.js restore"
  },
  "dependencies": {
    "@chkp/mcp-utils": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.16.0",
    "commander": "^14.0.3",
    "node-machine-id": "^1.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CheckPointSW/mcp-servers.git",
    "directory": "packages/reputation-service"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "@types/node": "^26.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4",
    "zod": "^3.24.4"
  },
  "keywords": [],
  "author": "",
  "license": "MIT"
}

{
  "name": "@chkp/workforce-ai-mcp",
  "version": "1.2.0",
  "description": "Official MCP server for Check Point Workforce AI — AI & Browse security policy management, asset visibility, and app catalog",
  "repository": {
    "type": "git",
    "url": "https://github.com/CheckPointSW/mcp-servers.git",
    "directory": "packages/workforce-ai"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "workforce-ai-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run build:bundle && npx shx chmod +x ./dist/index.js && npx shx cp src/server-config.json dist/",
    "build:bundle": "node ../../bundle-mcp.js",
    "build:tsc": "npx tsc && npx shx chmod +x ./dist/index.js && npx shx cp src/server-config.json dist/",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "spec:fetch": "tsx scripts/fetch-spec.ts",
    "generate-tools": "tsx scripts/generate-tools.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node ../../scripts/strip-bundled-deps.js",
    "postpack": "node ../../scripts/strip-bundled-deps.js restore"
  },
  "dependencies": {
    "@chkp/mcp-utils": "*",
    "@chkp/quantum-infra": "*",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "axios": "^1.13.5",
    "commander": "^13.1.0",
    "node-machine-id": "^1.1.12",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.5",
    "json-schema-to-zod": "^2.6.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "mcp",
    "checkpoint",
    "workforce-ai",
    "genai-security"
  ],
  "author": "Check Point"
}
